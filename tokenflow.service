# File path: /etc/systemd/system/tokenflow.service
# sudo systemctl daemon-reload
# sudo systemctl start tokenflow
# sudo systemctl enable tokenflow
# sudo systemctl status tokenflow
[Unit]
Description=TokenFlow Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/tokenflow  # 注意修改路径
ExecStart=/path/to/tokenflow/tokenflow --port 3000 --log-dir /path/to/tokenflow/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
